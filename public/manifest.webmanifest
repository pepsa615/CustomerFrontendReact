{
  "id": "/",
  "name": "PEPSA Customer",
  "short_name": "PEPSA",
  "description": "Book and track deliveries, manage your wallet, pay bills and run your business securely.",
  "start_url": "/auth/login?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#9d0208",
  "lang": "en-NG",
  "dir": "ltr",
  "categories": ["finance", "business", "productivity", "lifestyle"],
  "icons": [
    {
      "src": "/icons/pepsa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pepsa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pepsa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My wallet",
      "short_name": "Wallet",
      "url": "/app/wallet",
      "icons": [{ "src": "/icons/pepsa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Request delivery",
      "short_name": "Delivery",
      "url": "/app/orders",
      "icons": [{ "src": "/icons/pepsa-192.png", "sizes": "192x192" }]
    }
  ]
}
